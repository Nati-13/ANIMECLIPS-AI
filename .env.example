# AnimeClips AI - Environment Configuration

# Supabase PostgreSQL & Auth & Storage
# When configured, the system uses Supabase for database, authentication, and object storage.
# When empty, the application runs on resilient local file persistence and local storage for immediate testing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FFmpeg & FFprobe Executable Paths
# If empty, the engine detects ffmpeg and ffprobe from system PATH automatically
FFMPEG_PATH=
FFPROBE_PATH=

# Transcription Engine (options: "none" | "openai-whisper" | "local-whisper")
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=

# Vision AI Engine (options: "none" | "gemini" | "openai")
VISION_PROVIDER=none
VISION_API_KEY=

# Local Storage Directory for Source Videos & Renders
LOCAL_STORAGE_DIR=./storage
