# AnimeClips AI - Environment Configuration

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL, Authentication & Storage (Required for Production)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. NVIDIA Hosted API Catalog (Semantic Vision & Anime Analysis)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=zai-org/GLM-5.3-Flash

# ------------------------------------------------------------------------------
# 3. FFmpeg & FFprobe Executables (Media Worker)
# If empty, automatically detected from system PATH or standard Linux/Windows paths
# ------------------------------------------------------------------------------
FFMPEG_PATH=
FFPROBE_PATH=

# ------------------------------------------------------------------------------
# 4. Media Worker Daemon Configuration
# ------------------------------------------------------------------------------
WORKER_DATABASE_URL=
WORKER_POLL_INTERVAL_MS=3000
WORKER_CONCURRENCY=1
ENABLE_INLINE_MEDIA_WORKER=false

# ------------------------------------------------------------------------------
# 5. AI & Transcription Providers (Optional)
# ------------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=

VISION_PROVIDER=nvidia
VISION_API_KEY=

# ------------------------------------------------------------------------------
# 6. Local Storage Directory (Fallback for Development)
# ------------------------------------------------------------------------------
LOCAL_STORAGE_DIR=./storage
